[Desktop Entry]
Type=Application
Name=MarkupCraft
GenericName=PDF Markup and Takeoff
Comment=Mark up, measure and take off quantities on PDF drawings
Exec=markupcraft %F
TryExec=markupcraft
Icon=markupcraft
Terminal=false
StartupNotify=true
